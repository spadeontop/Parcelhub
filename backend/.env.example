# Direct PostgreSQL / Supabase connection (port 6543 pooler recommended for serverless)
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

JWT_SECRET="replace-with-jwt-secret-min-32-chars"
CLIENT_RETRIEVE_TIMER=5
AI_VERIFICATION=false

# Image attachment size limits in kilobytes (KB)
CLIENT_IMAGE_MAX_KB=110
STAFF_IMAGE_MAX_KB=200
