# Direct PostgreSQL / Supabase connection (port 6543 pooler recommended for serverless)
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

JWT_SECRET="replace-with-jwt-secret-min-32-chars"
CLIENT_RETRIEVE_TIMER=5
AI_VERIFICATION=false
AI_TRACKING_ID_MODE=present
OPENROUTER_API_KEY=
OPENROUTER_MODEL=tencent/hy4-flash
OPENROUTER_PROVIDER_ONLY=tencent/fp8
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_REASONING_ENABLED=true
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_TIMEOUT_MS=8000
AI_RATE_LIMIT_MAX_PER_MINUTE=5

# Image attachment size limits in kilobytes (KB)
CLIENT_IMAGE_MAX_KB=110
STAFF_IMAGE_MAX_KB=200

# Firebase Cloud Messaging (FCM v1) Configuration
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Supabase Realtime Broadcast (Auth-Only Refetch Signals)
REALTIME_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Transactional Email (OTP Verification & Account Recovery)
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp            # "smtp" (Gmail/generic) | "brevo" (HTTP API) | "resend" (HTTP API)
EMAIL_FROM="ParcelHub <your-account@gmail.com>"
# Optional public HTTPS logo URL override (defaults to inline attachment-free ParcelHub geometric mark)
# EMAIL_LOGO_URL="https://parcelhub-spade.vercel.app/parcelhub-logo.png"
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SEC=60
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_MAX_SENDS_PER_15M=5

# Option A: SMTP via nodemailer (Works with Gmail + 2FA App Password, no domain required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Option B: Brevo HTTP API (Single-sender email verification, no domain required)
BREVO_API_KEY=

# Option C: Resend HTTP API (Switch to this once you own a custom domain)
RESEND_API_KEY=

# Optional Live Realtime Simulation Credentials (used by `npm run test:v1:realtime:live`)
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_PASSWORD=
TEST_CUSTOMER_MPIN=
TEST_STAFF_USERNAME=
TEST_STAFF_PASSWORD=
