# ==============================================================================
# ParcelHub Backend Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL / Drizzle ORM)
# ------------------------------------------------------------------------------
# Default / Local Development: Leave DATABASE_URL commented or unset to use
# the embedded PGlite database stored locally in backend/pgdata.
#
# Production / Staging (Supabase): Uncomment and provide your connection string.
# NOTE: Use the Transaction Pooler (port 6543) for Vercel/serverless environments.
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used to sign and verify HMAC-SHA256 (HS256) JWT tokens for v1 APIs.
# Required by app/lib/v1/jwt.ts. Must be a secure random string (at least 32 chars).
JWT_SECRET="replace-with-a-secure-random-32-character-secret"

# ------------------------------------------------------------------------------
# 3. Parcel Claim Configuration
# ------------------------------------------------------------------------------
# Duration in minutes that a customer-initiated parcel claim pass remains active
# before expiring on staff handoff counters. Defaults to 5 minutes if unset.
CLIENT_RETRIEVE_TIMER=5

# ------------------------------------------------------------------------------
# 4. Feature Flags
# ------------------------------------------------------------------------------
# Set to "true" to require AI OCR verification on uploaded order screenshots
# before permitting PUT confirmation. Defaults to "false".
AI_VERIFICATION=false
